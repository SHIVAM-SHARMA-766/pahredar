# Copy to .env (gitignored) and fill in. Secrets come from ~/shivam/creds/.env.

# Postgres credentials, used by both the postgres and backend services.
POSTGRES_USER=pahredar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pahredar

# Host ports (bound to 127.0.0.1 only). 5433 avoids clashing with a local Postgres.
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8080

# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Raises the NVD rate limit from 5 to 50 requests per 30 seconds.
NVD_API_KEY=

# Optional. Raises GitHub's anonymous rate limit for cvelistV5 release downloads.
GITHUB_TOKEN=

# debug | info | warn | error
LOG_LEVEL=info

# Run the sync scheduler inside `serve`. Set false to run syncs only via
# `pahredar sync <source>`.
SYNC_ENABLED=true
# How often each source syncs (Go durations, minimum 1m). Every source also
# runs once at startup and can be triggered with POST /api/v1/sync/<source>.
# cvelist: new/changed CVE records, published hourly upstream.
CVELIST_SYNC_INTERVAL=1h
# nvd: NVD scores and CPE configurations, incremental by lastModified.
NVD_SYNC_INTERVAL=2h
# kev: CISA KEV catalog (updated a few times a week). epss: daily scores;
# a run that finds the same score date again is a no-op.
KEV_SYNC_INTERVAL=6h
EPSS_SYNC_INTERVAL=6h
# exploitdb, metasploit, nuclei indexes.
EXPLOITS_SYNC_INTERVAL=24h

# Only needed when running the backend outside Docker (go run ./cmd/pahredar serve).
# Inside Compose, DATABASE_URL is built from the POSTGRES_* values above.
# DATABASE_URL=postgres://pahredar:change-me@127.0.0.1:5433/pahredar?sslmode=disable
# HTTP_ADDR=:8080
# Scratch space for downloads (default: system temp dir). Compose sets /var/lib/pahredar.
# DATA_DIR=/tmp
